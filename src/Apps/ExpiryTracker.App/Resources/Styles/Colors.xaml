<?xml version="1.0" encoding="UTF-8" ?>
<?xaml-comp compile="true" ?>
<ResourceDictionary
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml">

    <!-- Status colours: same values as Services/Palette.cs. Always paired with text. -->
    <Color x:Key="Expired">#B3261E</Color>
    <Color x:Key="UseSoon">#9A4D00</Color>
    <Color x:Key="Fresh">#1E7B34</Color>
    <Color x:Key="NoDate">#5F6368</Color>

    <Color x:Key="Primary">#00696B</Color>
    <Color x:Key="OnPrimary">#FFFFFF</Color>
    <Color x:Key="PrimaryDark">#4DD9DB</Color>
    <Color x:Key="OnPrimaryDark">#003738</Color>

    <Color x:Key="PageLight">#FFFFFF</Color>
    <Color x:Key="PageDark">#101414</Color>
    <Color x:Key="CardLight">#F0F5F5</Color>
    <Color x:Key="CardDark">#1E2626</Color>
    <Color x:Key="TextLight">#151A1A</Color>
    <Color x:Key="TextDark">#ECF2F2</Color>
    <Color x:Key="SubtleTextLight">#3F4A4A</Color>
    <Color x:Key="SubtleTextDark">#BAC7C7</Color>
    <Color x:Key="BorderLight">#C2CCCC</Color>
    <Color x:Key="BorderDark">#3C4747</Color>

</ResourceDictionary>
