<?xml version="1.0" encoding="utf-8"?>
<!-- Android 12+: Google backup only when it can be end-to-end encrypted with the screen lock;
     phone-to-phone transfer (Samsung Smart Switch, new-phone setup) always. Same files in both. -->
<data-extraction-rules>
    <cloud-backup disableIfNoEncryptionCapabilities="true">
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="file" path="." />
        <include domain="sharedpref" path="." />
    </device-transfer>
</data-extraction-rules>
