<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<!-- Android first. Windows is added in Release 5; iOS only if a Mac becomes available. -->
		<TargetFrameworks>net10.0-android</TargetFrameworks>

		<OutputType>Exe</OutputType>
		<RootNamespace>ExpiryTracker.App</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- Enable XAML source generation for faster build times and improved performance.
		     This generates C# code from XAML at compile time instead of runtime inflation.
		     To disable, remove this line.
		     For individual files, you can override by setting Inflator metadata:
		       <MauiXaml Update="MyPage.xaml" Inflator="Default" /> (reverts to defaults: Runtime for Debug, XamlC for Release)
		       <MauiXaml Update="MyPage.xaml" Inflator="Runtime" /> (force runtime inflation) -->
		<MauiXamlInflator>SourceGen</MauiXamlInflator>

		<!-- Display name -->
		<ApplicationTitle>Home Tracker</ApplicationTitle>

		<!-- App Identifier. Must never change after the first release, or phones treat updates as a different app. -->
		<ApplicationId>io.github.saisanthosh97.hometracker</ApplicationId>

		<!-- Versions -->
		<!-- ApplicationDisplayVersion must match the GitHub release tag (v0.1.0) for update checks.
		     ApplicationVersion must go up by one with every release. -->
		<ApplicationDisplayVersion>0.1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- To develop, package, and publish an app to the Microsoft Store, see: https://aka.ms/MauiTemplateUnpackaged -->
		<WindowsPackageType>None</WindowsPackageType>

		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">26.0</SupportedOSPlatformVersion>
		<!-- Phones are ARM64 (all target Samsung models); Debug keeps the defaults.
		     -p:EmulatorBuild=true builds the Release app for the x86-64 emulator to test it on this PC. -->
		<RuntimeIdentifiers Condition="'$(Configuration)' == 'Release' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-arm64</RuntimeIdentifiers>
		<RuntimeIdentifiers Condition="'$(EmulatorBuild)' == 'true' and $([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">android-x64</RuntimeIdentifiers>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon -->
		<MauiIcon Include="Resources\AppIcon\appicon.svg" ForegroundFile="Resources\AppIcon\appiconfg.svg" Color="#00696B" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Splash\splash.svg" Color="#00696B" BaseSize="128,128" />

		<!-- Images -->
		<MauiImage Include="Resources\Images\*" />

		<!-- UI text. Translations go in AppResources.<language>.resx (e.g. AppResources.hi.resx). -->
		<EmbeddedResource Update="Resources\Strings\AppResources.resx"
		                  StronglyTypedLanguage="CSharp"
		                  StronglyTypedClassName="AppResources"
		                  StronglyTypedNamespace="ExpiryTracker.App.Resources.Strings"
		                  StronglyTypedFileName="$(IntermediateOutputPath)AppResources.Designer.cs" />

		<!-- Custom Fonts -->
		<MauiFont Include="Resources\Fonts\*" />

		<!-- Raw Assets (also remove the "Resources\Raw" prefix) -->
		<MauiAsset Include="Resources\Raw\**" LogicalName="%(RecursiveDir)%(Filename)%(Extension)" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="$(MauiVersion)" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="10.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <ProjectReference Include="..\..\Components\Core.ShelfLife\Core.ShelfLife.csproj" />
	  <ProjectReference Include="..\..\Components\Core.ExpiryEngine\Core.ExpiryEngine.csproj" />
	  <ProjectReference Include="..\..\Components\Core.DateExtraction\Core.DateExtraction.csproj" />
	  <ProjectReference Include="..\..\Components\Core.Items\Core.Items.csproj" />
	  <ProjectReference Include="..\..\Components\Storage.Sqlite\Storage.Sqlite.csproj" />
	  <ProjectReference Include="..\..\Components\Core.AppUpdater\Core.AppUpdater.csproj" />
	  <ProjectReference Include="..\..\Components\Device.Reminders\Device.Reminders.csproj" />
	</ItemGroup>

</Project>
