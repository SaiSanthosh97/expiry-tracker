<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:vm="clr-namespace:ExpiryTracker.App.ViewModels"
             xmlns:s="clr-namespace:ExpiryTracker.App.Resources.Strings"
             x:Class="ExpiryTracker.App.Views.SettingsPage"
             x:DataType="vm:SettingsViewModel"
             Title="{x:Static s:AppResources.Settings_Title}">

    <ScrollView>
        <VerticalStackLayout Padding="16,8,16,32" Spacing="10">

            <!-- Family -->
            <Button Text="{x:Static s:AppResources.Settings_Family}" Command="{Binding OpenFamilyCommand}" FontSize="20" HeightRequest="64" />

            <!-- Keep reminders working -->
            <Label Text="{x:Static s:AppResources.Settings_Reminders}" Style="{StaticResource SectionLabel}" FontSize="22" />

            <Grid ColumnDefinitions="*,Auto">
                <Label Text="{x:Static s:AppResources.Settings_ReminderTime}" VerticalOptions="Center" />
                <TimePicker Grid.Column="1" Time="{Binding ReminderTime}" />
            </Grid>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{x:Static s:AppResources.Settings_Notifications}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{x:Static s:AppResources.Settings_Done}" TextColor="{StaticResource Fresh}"
                           FontFamily="OpenSansSemibold" VerticalOptions="Center" IsVisible="{Binding NotificationsOk}" />
                    <Button Grid.Column="1" Text="{x:Static s:AppResources.Settings_Fix}" Command="{Binding AllowNotificationsCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding NotificationsOk}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <Border Style="{StaticResource Card}" Padding="14">
                <Grid ColumnDefinitions="*,Auto" ColumnSpacing="8">
                    <Label Text="{x:Static s:AppResources.Settings_Battery}" VerticalOptions="Center" />
                    <Label Grid.Column="1" Text="{x:Static s:AppResources.Settings_Done}" TextColor="{StaticResource Fresh}"
                           FontFamily="OpenSansSemibold" VerticalOptions="Center" IsVisible="{Binding BatteryOk}" />
                    <Button Grid.Column="1" Text="{x:Static s:AppResources.Settings_Fix}" Command="{Binding FixBatteryCommand}">
                        <Button.Triggers>
                            <DataTrigger TargetType="Button" Binding="{Binding BatteryOk}" Value="True">
                                <Setter Property="IsVisible" Value="False" />
                            </DataTrigger>
                        </Button.Triggers>
                    </Button>
                </Grid>
            </Border>

            <Label Text="{x:Static s:AppResources.Settings_SamsungTip}" Style="{StaticResource Subtle}" />
            <Button Text="{x:Static s:AppResources.Settings_OpenAppSettings}" Command="{Binding OpenAppSettingsCommand}" Style="{StaticResource OutlineButton}" />
            <Button Text="{x:Static s:AppResources.Settings_TestReminder}" Command="{Binding SendTestReminderCommand}" />

            <!-- Backup -->
            <Label Text="{x:Static s:AppResources.Settings_Backup}" Style="{StaticResource SectionLabel}" FontSize="22" />
            <Button Text="{x:Static s:AppResources.Settings_Export}" Command="{Binding ExportCommand}" Style="{StaticResource OutlineButton}" />
            <Button Text="{x:Static s:AppResources.Settings_Import}" Command="{Binding ImportCommand}" Style="{StaticResource OutlineButton}" />

            <!-- Updates -->
            <Label Text="{x:Static s:AppResources.Settings_Updates}" Style="{StaticResource SectionLabel}" FontSize="22" />
            <Label Text="{Binding VersionText}" Style="{StaticResource Subtle}" />
            <Button Text="{x:Static s:AppResources.Settings_CheckUpdates}" Command="{Binding CheckForUpdatesCommand}" Style="{StaticResource OutlineButton}" />

            <!-- About -->
            <Label Text="{x:Static s:AppResources.Settings_About}" Style="{StaticResource SectionLabel}" FontSize="22" />
            <Label Text="{x:Static s:AppResources.About_Disclaimer}" />
            <Label Text="{x:Static s:AppResources.About_Privacy}" Style="{StaticResource Subtle}" />
            <Label Text="{x:Static s:AppResources.About_License}" Style="{StaticResource Subtle}" />
            <Button Text="{x:Static s:AppResources.About_SourceCode}" Command="{Binding OpenSourceCodeCommand}" Style="{StaticResource OutlineButton}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>
