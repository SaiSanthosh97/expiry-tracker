<?xml version="1.0" encoding="UTF-8" ?>
<Shell
    x:Class="ExpiryTracker.App.AppShell"
    xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
    xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
    xmlns:views="clr-namespace:ExpiryTracker.App.Views"
    xmlns:s="clr-namespace:ExpiryTracker.App.Resources.Strings"
    Title="{x:Static s:AppResources.AppName}"
    FlyoutBehavior="Disabled">

    <!-- Two tabs at the bottom: expiry list and medicines. -->
    <TabBar>
        <ShellContent Title="{x:Static s:AppResources.Tab_Expiry}"
                      ContentTemplate="{DataTemplate views:HomePage}"
                      Route="home">
            <ShellContent.Icon>
                <FontImageSource Glyph="🗓" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
        <ShellContent Title="{x:Static s:AppResources.Tab_Medicines}"
                      ContentTemplate="{DataTemplate views:MedicinesPage}"
                      Route="medicines">
            <ShellContent.Icon>
                <FontImageSource Glyph="💊" Size="22" />
            </ShellContent.Icon>
        </ShellContent>
    </TabBar>

</Shell>
